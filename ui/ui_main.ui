           <property name="styleSheet">
            <string notr="true">/* ============================================================
   HALAMAN LAPORAN (PROFESSIONAL ANALYTICS STYLE)
   ============================================================ */

/* 1. BACKGROUND HALAMAN */
QWidget#pageLaporan {
    background-color: #F8FAFC; /* Slate 50 (Lebih dingin &amp; bersih) */
}

/* 2. HEADER JUDUL */
QLabel#lblJudulLaporan {
    font-size: 28px;
    font-weight: 900;     /* Extra Bold */
    color: #0F172A;       /* Hitam Pekat */
    margin-bottom: 20px;
    letter-spacing: -0.5px;
}

/* 3. FILTER BAR (WHITE PANEL) */
QFrame#frameFilterLaporan {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 12px;
    /* Sedikit shadow halus */
    border-bottom: 3px solid #E2E8F0;
}

/* Label Kecil di Filter */
QFrame#frameFilterLaporan QLabel {
    font-weight: 700;
    color: #64748B;
    margin-right: 5px;
}

/* Dropdown (ComboBox) */
QComboBox#comboLapKelas, QComboBox#comboLapBulan {
    background-color: #F1F5F9;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 8px 15px;
    font-weight: 600;
    color: #1E293B;
    min-width: 140px;
}

/* --- TOMBOL AKSI (ACTION BUTTONS) --- */

/* Tombol Tampilkan (Biru Elegan) */
QPushButton#btnTampilkan {
    background-color: #3B82F6;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 13px;
}
QPushButton#btnTampilkan:hover { background-color: #2563EB; }

/* Tombol Excel (Hijau Emerald Professional) */
QPushButton#btnExportExcel {
    background-color: #10B981;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 13px;
    border-bottom: 3px solid #059669; /* Efek 3D */
}
QPushButton#btnExportExcel:hover { 
    background-color: #059669; 
    margin-top: 2px;
    border-bottom: 1px solid #059669;
}

/* Tombol PDF (Merah Rose Professional) */
QPushButton#btnCetakPDF {
    background-color: #F43F5E;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 13px;
    border-bottom: 3px solid #E11D48; /* Efek 3D */
}
QPushButton#btnCetakPDF:hover { 
    background-color: #E11D48; 
    margin-top: 2px;
    border-bottom: 1px solid #E11D48;
}


/* 4. KARTU STATISTIK (HERO SECTION) */
QFrame#cardStat1, QFrame#cardStat2, QFrame#cardStat3 {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 16px; /* Lebih membulat */
    border-bottom: 4px solid #CBD5E1;
    margin-top: 20px;
    margin-bottom: 20px;
}

/* AKSEN WARNA TEBAL DI KIRI KARTU */
QFrame#cardStat1 { border-left: 8px solid #3B82F6; } /* Biru */
QFrame#cardStat2 { border-left: 8px solid #10B981; } /* Hijau */
QFrame#cardStat3 { border-left: 8px solid #F43F5E; } /* Merah */

/* Judul Kecil (Header Kartu) */
QFrame#cardStat1 QLabel, QFrame#cardStat2 QLabel, QFrame#cardStat3 QLabel {
    color: #64748B;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    background: transparent;
    margin-bottom: 5px;
}

/* ANGKA RAKSASA (Pastikan objectName sudah diganti!) */
QLabel#lblAngkaStat1, QLabel#lblAngkaStat2, QLabel#lblAngkaStat3 {
    font-size: 36px;      /* Sangat Besar */
    font-weight: 900;     /* Sangat Tebal */
    color: #0F172A;       /* Hitam Pekat */
    background: transparent;
    margin-top: 5px;
}
/* Warna Khusus Angka */
QLabel#lblAngkaStat1 { color: #3B82F6; } /* Angka Biru */
QLabel#lblAngkaStat2 { color: #10B981; } /* Angka Hijau */
QLabel#lblAngkaStat3 { color: #F43F5E; } /* Angka Merah */


/* 5. TABEL REKAPITULASI (CLEAN &amp; GRIDLESS) */
QFrame#cardTabelLaporan {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    border-bottom: 4px solid #CBD5E1;
}

QTableWidget#tableRekap {
    background-color: #FFFFFF;
    border: none;
    gridline-color: transparent; /* Hilangkan garis grid biar modern */
    font-size: 13px;
    color: #334155;
    padding: 10px;
}

/* Header Tabel */
QTableWidget#tableRekap QHeaderView::section {
    background-color: #F1F5F9; /* Abu Terang */
    color: #475569;            /* Teks Abu Gelap */
    padding: 15px 10px;        /* Padding Lega */
    border: none;
    border-bottom: 2px solid #E2E8F0;
    font-weight: 800;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* Warna Item Tabel */
QTableWidget#tableRekap::item {
    border-bottom: 1px solid #F1F5F9; /* Garis tipis antar baris */
    padding: 5px;
}
QTableWidget#tableRekap::item:selected {
    background-color: #EFF6FF; /* Highlight Biru Muda */
    color: #2563EB;
}</string>
           </property>
           <property name="currentIndex">
            <number>3</number>
           </property>
           <widget class="QWidget" name="pageDashboard">
            <property name="styleSheet">
             <string notr="true">/* ============================================================
   FIX BACKGROUND &amp; STYLE PRO (EDLINK VIBE)
   ============================================================ */

/* 1. GLOBAL BACKGROUND (DASAR APLIKASI) */
/* Kita paksa background utama jadi ABU MUDA (Slate 100) */
QMainWindow, QWidget#centralwidget, QStackedWidget {
    background-color: #F1F5F9; 
    font-family: &quot;Segoe UI&quot;, sans-serif;
}

/* 2. KHUSUS HALAMAN DASHBOARD */
/* Memastikan halaman dashboard tidak transparan/biru */
QWidget#pageDashboard {
    background-color: #F1F5F9; 
}

/* 3. SIDEBAR KIRI (WAJIB BIRU) */
/* Pastikan objectName sidebar kamu: contentFrame */
QWidget#contentFrame {
    background-color: #2563EB; /* Biru Royal */
    border: none;
    border-right: 1px solid #1E40AF; /* Garis batas tipis */
}

/* --- ELEMEN SIDEBAR --- */
/* Judul Aplikasi */
QWidget#contentFrame QLabel#labelJudul {
    color: #FFFFFF !important;
    font-size: 22px;
    font-weight: 900;
    margin-top: 15px;
    margin-bottom: 20px;
    padding-left: 10px;
}

/* Tombol Navigasi */
QWidget#contentFrame QPushButton {
    background-color: transparent;
    color: #DBEAFE; 
    text-align: left;
    padding-left: 20px;
    height: 48px;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    margin: 2px 10px;
}
QWidget#contentFrame QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.15);
    color: #FFFFFF;
}
QWidget#contentFrame QPushButton:checked {
    background-color: #FFFFFF;
    color: #2563EB;
    font-weight: bold;
    box-shadow: 2px 2px 5px rgba(0,0,0,0.1);
}

/* Profil User Bawah */
QWidget#contentFrame QFrame#frameProfil {
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 12px;
}
QWidget#contentFrame QFrame#frameProfil QLabel {
    color: #FFFFFF !important;
}

/* 4. AREA KONTEN DASHBOARD */
/* Header Teks */
QLabel#lblDashboard { color: #0F172A; font-size: 28px; font-weight: 800; }
QLabel#lblTanggal { color: #64748B; font-size: 14px; font-weight: 500; }
QLabel#lblJam { color: #2563EB; font-size: 18px; font-weight: bold; font-family: monospace; }

/* KARTU JADWAL (BESAR) */
QFrame#frameJadwal {
    background-color: #FFFFFF; /* Wajib Putih */
    border-radius: 16px;
    border: 1px solid #E2E8F0;
    border-bottom: 4px solid #E2E8F0;
    border-left: 6px solid #2563EB; /* Aksen Biru Kiri */
}

/* KARTU STATISTIK (BAWAH) */
QFrame#cardHadir, QFrame#cardTugas, QFrame#cardInfo {
    background-color: #FFFFFF; /* Wajib Putih */
    border-radius: 16px;
    border: 1px solid #E2E8F0;
    border-bottom: 4px solid #E2E8F0;
}

/* ISI KARTU BAWAH */
QLabel#lblJudulHadir, QLabel#lblJudulTugas, QLabel#lblJudulInfo {
    color: #64748B; font-weight: 700; font-size: 11px; text-transform: uppercase;
}
QLabel#lblAngkaHadir, QLabel#lblAngkaTugas {
    color: #0F172A; font-size: 48px; font-weight: 800;
}
QLabel#lblKetHadir, QLabel#lblKetTugas, QLabel#lblIsiInfo {
    background-color: #F1F5F9; /* Badge Abu */
    color: #475569;
    padding: 5px 10px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 600;
}</string>
