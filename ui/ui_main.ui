           <widget class="QWidget" name="pageKelas">
            <property name="styleSheet">
             <string notr="true">/* ============================================================
   HALAMAN KELAS SAYA (MODERN &amp; STREAMLINED)
   ============================================================ */

/* 1. BACKGROUND HALAMAN */
QWidget#pageKelas {
    background-color: #F8FAFC; 
}

/* 2. HEADER AREA */
QLabel#lblJudulPageKelas {
    color: #0F172A;
    font-size: 26px;
    font-weight: 800;
}

QLineEdit#inputCariKelas {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    padding: 10px 16px;
    font-size: 14px;
}

QPushButton#btnBuatKelas {
    background-color: #2563EB;
    color: white;
    border-radius: 12px;
    padding: 10px 24px;
    font-weight: 700;
    border-bottom: 3px solid #1E40AF;
}

/* ============================================================
   KARTU KELAS (DENGAN ACTION STRIP DI BAWAH)
   ============================================================ */

QFrame#cardKelasSample {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 20px;
    /* Bayangan halus */
    border-bottom: 2px solid #F1F5F9;
}

/* Header Kartu (Misal: Kode Kelas) */
QFrame#bannerKelas {
    background-color: #EFF6FF; /* Biru sangat muda */
    border-top-left-radius: 18px; 
    border-top-right-radius: 18px;
    border-bottom: 1px solid #DBEAFE;
}

QLabel#lblKodeMapel {
    color: #2563EB;
    font-weight: 800;
    font-size: 13px;
    text-transform: uppercase;
}

/* Body Teks */
QLabel#lblNamaKelas {
    font-size: 18px;
    font-weight: 800;
    color: #1E293B;
}

QLabel#lblJadwalKelas, QLabel#lblPengajarKelas {
    font-size: 13px;
    color: #64748B;
}

/* --- ACTION STRIP (DROW TOMBOL DI BAWAH) --- */

/* 1. Tombol Masuk (Primary - Biru) */
QPushButton#btnMasukKelas {
    background-color: #2563EB;
    color: white;
    border-radius: 10px;
    font-weight: 800;
    padding: 10px 20px;
    min-width: 120px;
}
QPushButton#btnMasukKelas:hover {
    background-color: #1D4ED8;
}

/* 2. Tombol Impor Siswa (Secondary - Hijau) */
/* Gus, tombol ini kita taruh di dalam kartu sebagai ikon/teks kecil */
QPushButton#btnImportSiswa {
    background-color: #F0FDF4;
    color: #166534;
    border: 1px solid #BBF7D0;
    border-radius: 10px;
    font-weight: 700;
    font-size: 12px;
    padding: 8px 16px;
}
QPushButton#btnImportSiswa:hover {
    background-color: #DCFCE7;
    border-color: #16A34A;
}

/* 3. Tombol Hapus (Danger - Merah Soft) */
QPushButton#btnHapusKelas {
    background-color: #FFF1F2;
    color: #BE123C;
    border-radius: 10px;
    font-weight: 700;
    font-size: 12px;
    padding: 8px 16px;
}
QPushButton#btnHapusKelas:hover {
    background-color: #FFE4E6;
}</string>
            </property>
