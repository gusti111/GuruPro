                      <property name="styleSheet">
                       <string notr="true">/* ============================================================
   GURU PRO - MASTER STYLESHEET (PROFESSIONAL CLEAN LOOK)
   ============================================================ */

/* --- 1. SETTING FONDASI (GLOBAL) --- */
/* Mengunci background utama jadi Abu Soft agar tidak ada 'bocor' biru */
QMainWindow, QWidget#centralwidget, QStackedWidget {
    background-color: #F1F5F9; 
    font-family: &quot;Segoe UI&quot;, sans-serif;
    outline: none;
}

/* Memastikan halaman-halaman konten background-nya senada */
QWidget#pageDashboard, QWidget#pageKelas {
    background-color: #F1F5F9;
}

/* --- 2. SIDEBAR NAVIGASI (KIRI) --- */
/* Satu-satunya elemen yang boleh berwarna Biru */
QWidget#contentFrame {
    background-color: #2563EB; /* Royal Blue */
    border: none;
    border-right: 1px solid #1E40AF;
}

/* Judul Aplikasi */
QWidget#contentFrame QLabel#labelJudul {
    color: #FFFFFF !important;
    font-size: 22px;
    font-weight: 900;
    letter-spacing: 0.5px;
    margin-top: 20px;
    margin-bottom: 25px;
    padding-left: 15px;
}

/* Tombol Menu Sidebar */
QWidget#contentFrame QPushButton {
    background-color: transparent;
    color: #DBEAFE; 
    text-align: left;
    padding-left: 20px;
    height: 48px;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    margin: 4px 12px; /* Margin kiri-kanan biar tombol 'bernapas' */
}
/* Efek Hover Menu */
QWidget#contentFrame QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.15);
    color: #FFFFFF;
}
/* Efek Menu Aktif */
QWidget#contentFrame QPushButton:checked {
    background-color: #FFFFFF;
    color: #2563EB;
    font-weight: bold;
    box-shadow: 0px 4px 10px rgba(0,0,0,0.1);
}

/* Profil User (Bawah) */
QWidget#contentFrame QFrame#frameProfil {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    margin: 15px;
}
QWidget#contentFrame QFrame#frameProfil QLabel {
    color: #FFFFFF !important;
    font-weight: 600;
}

/* --- 3. KOMPONEN UMUM (INPUT &amp; TOMBOL) --- */
/* Search Bar (Input Pencarian) */
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 14px;
    color: #334155;
}
QLineEdit:focus {
    border: 1px solid #2563EB; /* Biru saat diketik */
}

/* Tombol Utama (Biru Solid) - Contoh: + Buat Kelas */
QPushButton#btnBuatKelas, QPushButton#btnMulaiKelas {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 14px;
}
QPushButton#btnBuatKelas:hover, QPushButton#btnMulaiKelas:hover {
    background-color: #1D4ED8;
}

/* Dropdown Filter */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 5px 10px;
    color: #475569;
}

/* --- 4. KARTU KELAS (CARD STYLE) --- */
/* Frame Utama Kartu */
QFrame#cardKelasSample {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    border-bottom: 3px solid #CBD5E1; /* Shadow tebal bawah */
}
QFrame#cardKelasSample:hover {
    border-color: #2563EB; /* Jadi biru saat disentuh */
    border-bottom-color: #2563EB;
    cursor: pointer;
}

/* Banner Biru Atas */
QFrame#bannerKelas {
    background-color: #2563EB;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}
/* Teks Kode Mapel di Banner */
QFrame#bannerKelas QLabel {
    color: #FFFFFF;
    font-weight: bold;
    font-size: 14px;
    padding-left: 8px;
    background: transparent;
}

/* Teks Judul Mapel */
QLabel#lblNamaKelas {
    font-size: 16px;
    font-weight: 800;
    color: #1E293B;
    margin-top: 12px;
}

/* Tombol Masuk (Footer) */
QPushButton#btnMasukKelas {
    background-color: #F8FAFC;
    color: #2563EB;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    font-size: 12px;
    font-weight: bold;
    min-width: 70px;
    max-width: 90px;
    height: 28px;
}
QPushButton#btnMasukKelas:hover {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
}</string>
