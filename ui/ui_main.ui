             <property name="styleSheet">
              <string notr="true">/* ============================================================
   SIDEBAR NAVIGASI (FINAL COMPLETE VERSION)
   Target Object: sidebarFrame (QFrame)
   ============================================================ */

/* 1. CONTAINER UTAMA (BACKGROUND BIRU) */
QFrame#sidebarFrame {
    background-color: #2563EB !important; /* Paksa Biru Branding */
    border: none;
    border-right: 1px solid #1E40AF;      /* Garis batas kanan */
    min-width: 250px;                     /* Lebar minimum */
}

/* 2. JUDUL APLIKASI (GURU PRO) */
QFrame#sidebarFrame QLabel#labelJudul {
    color: #FFFFFF !important;
    font-family: &quot;Segoe UI&quot;, sans-serif;
    font-size: 24px;
    font-weight: 900;      /* Extra Bold */
    margin-top: 25px;
    margin-bottom: 30px;
    padding-left: 20px;
}

/* 3. TOMBOL NAVIGASI (GAYA KAPSUL MELAYANG) */
QFrame#sidebarFrame QPushButton {
    background-color: transparent;
    color: #DBEAFE;        /* Teks Biru Muda (Soft) */
    text-align: left;
    padding-left: 20px;
    height: 42px;
    border: none;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;

    /* Margin Kiri-Kanan agar tombol 'mengambang' */
    margin-left: 15px;
    margin-right: 15px;
    margin-bottom: 5px;
}

/* 3.1 Efek Hover (Saat Mouse Lewat) */
QFrame#sidebarFrame QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.15);
    color: #FFFFFF;
    padding-left: 25px;    /* Animasi geser sedikit */
}

/* 3.2 Efek Aktif/Checked (Tombol Putih) */
QFrame#sidebarFrame QPushButton:checked {
    background-color: #FFFFFF !important;
    color: #2563EB !important;
    font-weight: 800;
    border-bottom: 3px solid #E2E8F0; /* Shadow halus bawah */
}


/* 4. BAGIAN PROFIL USER (BAWAH) */

/* 4.1 Bingkai Profil */
QFrame#sidebarFrame QFrame#frameProfil {
    background-color: rgba(0, 0, 0, 0.15); /* Hitam transparan */
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);

    /* Posisi &amp; Jarak */
    margin-left: 15px;
    margin-right: 15px;
    margin-bottom: 20px;
    padding: 10px;         /* Memberi ruang napas untuk teks di dalam */
    min-height: 50px;
}

/* 4.2 Reset Label Default di dalam Profil */
QFrame#sidebarFrame QFrame#frameProfil QLabel {
    background: transparent;
    border: none;
    padding: 0px;
    margin: 0px;
}

/* 4.3 Teks Nama Guru (Wajib beri objectName: labelNamaProfil) */
QFrame#sidebarFrame QFrame#frameProfil QLabel#labelNamaProfil {
    color: #FFFFFF !important;
    font-size: 14px;
    font-weight: 700;      /* Bold */
    margin-bottom: 4px;    /* Jarak ke NIP */
}

/* 4.4 Teks NIP (Wajib beri objectName: labelNipProfil) */
QFrame#sidebarFrame QFrame#frameProfil QLabel#labelNipProfil {
    color: #BFDBFE !important; /* Biru Muda */
    font-size: 12px;
    font-weight: 500;
}</string>
