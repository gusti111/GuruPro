           <widget class="QWidget" name="pagePerangkat">
            <property name="styleSheet">
             <string notr="true">/* ============================================================
   HALAMAN PERANGKAT TERTAUT (FIXED CENTER ALIGNMENT)
   ============================================================ */

/* 1. BACKGROUND HALAMAN */
QWidget#pagePerangkat {
    background-color: #F8FAFC; /* Slate 50 */
}

/* 2. JUDUL HALAMAN */
QLabel#lblJudulPerangkat {
    font-family: &quot;Segoe UI&quot;, sans-serif;
    font-size: 30px;
    font-weight: 900;
    color: #0F172A;
    margin-bottom: 25px;
    letter-spacing: -0.5px;
}

/* 3. KARTU UTAMA (CONTAINER) */
QFrame#cardQrContainer {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 24px;
    
    /* Shadow 3D Halus */
    border-bottom: 6px solid #DBEAFE; 
    border-right: 1px solid #E2E8F0;
}

/* --- BAGIAN KIRI: AREA SCANNER --- */

/* Bingkai QR Code */
QLabel#lblQrCode {
    background-color: #FFFFFF;
    border: 2px dashed #CBD5E1; 
    border-radius: 20px;
    
    /* Ukuran Wajib Fix agar kotak sempurna */
    min-width: 240px;
    min-height: 240px;
    max-width: 240px;
    max-height: 240px;
    
    qproperty-alignment: AlignCenter;
    color: #94A3B8;
    font-weight: 600;
    
    /* MARGIN AGAR POSISI DI TENGAH */
    /* Kita dorong dari kiri dan kanan dengan jarak sama */
    margin-left: 20px;
    margin-right: 20px;
    margin-top: 10px;
}

/* Efek Hover QR */
QLabel#lblQrCode:hover {
    border-color: #3B82F6;
    background-color: #F0F9FF;
}

/* Badge Status (Pill Merah) */
QLabel#lblStatusKoneksi {
    background-color: #FEF2F2;
    color: #E11D48;
    border: 1px solid #FECDD3;
    border-radius: 18px;
    
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    qproperty-alignment: AlignCenter;
    
    /* TRIK CENTER: Margin Kiri-Kanan Besar &amp; Seimbang */
    margin-top: 20px;
    margin-bottom: 5px;
    margin-left: 40px;  /* Dorong 40px dari kiri */
    margin-right: 40px; /* Dorong 40px dari kanan */
    padding: 8px 0px;
    min-height: 20px;
}

/* Tombol Refresh (Pill Biru) - FIX TENGAH */
QPushButton#btnRefreshQr {
    background-color: #FFFFFF;
    color: #2563EB;
    border: 1px solid #BFDBFE;
    border-radius: 12px;
    
    font-weight: 700;
    font-size: 13px;
    
    /* TRIK CENTER: Margin SAMAKAN dengan Badge di atasnya */
    margin-top: 10px;
    margin-left: 40px;  /* Wajib sama dengan margin-left status */
    margin-right: 40px; /* Wajib sama dengan margin-right status */
    padding: 10px 0px;
}

QPushButton#btnRefreshQr:hover {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    cursor: pointer;
}


/* --- BAGIAN KANAN: TEKS PANDUAN --- */

/* Judul Kecil */
QLabel#lblHeaderPanduan {
    font-size: 18px;
    font-weight: 800;
    color: #1E293B;
    margin-bottom: 10px;
    padding-bottom: 10px;
    border-bottom: 2px solid #F1F5F9;
    margin-right: 30px; 
}

/* Isi Teks */
QLabel#lblPanduanQr {
    color: #475569;
    font-size: 14px;
    font-weight: 500;
    line-height: 26px; 
    margin-right: 10px;
}

/* Footer Info */
QLabel#lblInfoTambahan {
    color: #94A3B8;
    font-size: 12px;
    font-style: italic;
    margin-top: 15px;
    background-color: #F8FAFC;
    border-radius: 8px;
    padding: 10px;
    margin-right: 30px;
}</string>
