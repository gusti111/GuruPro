           <widget class="QWidget" name="pagePengaturan">
            <property name="styleSheet">
             <string notr="true">/* ============================================================
   HALAMAN PENGATURAN (SETTINGS - CLEAN DASHBOARD STYLE)
   ============================================================ */

/* 1. BACKGROUND HALAMAN */
QWidget#pagePengaturan {
    background-color: #F8FAFC; /* Slate 50 (Putih Kebiruan) */
}

/* 2. HEADER JUDUL */
QLabel#lblJudulPengaturan {
    font-size: 28px;
    font-weight: 900;     /* Extra Bold */
    color: #0F172A;       /* Hitam Pekat */
    margin-bottom: 20px;
    letter-spacing: -0.5px;
}

/* 3. KARTU PROFIL &amp; SISTEM (CONTAINER PUTIH) */
QFrame#cardProfil, QFrame#cardSystem {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 16px;       /* Sudut Membulat Modern */
    border-bottom: 4px solid #CBD5E1; /* Shadow Bawah Tebal */
    padding: 25px;             /* Jarak dalam lega */
}

/* Judul Kecil di dalam Kartu */
QFrame#cardProfil QLabel, QFrame#cardSystem QLabel {
    color: #64748B;
    font-weight: 700;
    font-size: 13px;
    margin-bottom: 5px;
    margin-top: 10px;
}

/* FOTO PROFIL BULAT (Placeholder) */
QLabel#lblFotoProfilSetting {
    background-color: #E2E8F0;
    border: 2px dashed #94A3B8; /* Garis Putus-putus */
    border-radius: 40px;        /* Setengah dari 80px biar bulat */
    min-width: 80px;
    min-height: 80px;
    max-width: 80px;
    max-height: 80px;
    margin-bottom: 10px;
    margin-top: 0px !important; /* Reset margin khusus foto */
}

/* INPUT FIELD (FORM) */
QLineEdit#inputEditNama, QLineEdit#inputEditNIP, QLineEdit#inputEditMapel {
    background-color: #F8FAFC;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 10px 15px;
    font-size: 14px;
    color: #1E293B;
    font-weight: 600;
    margin-bottom: 5px;
}
QLineEdit:focus {
    border: 2px solid #3B82F6; /* Fokus Biru Tebal */
    background-color: #FFFFFF;
}

/* --- TOMBOL AKSI --- */

/* 1. Tombol Ganti Foto (Kecil, Outline) */
QPushButton#btnGantiFoto {
    background-color: transparent;
    color: #2563EB;
    border: 1px solid #2563EB;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 11px;
    font-weight: bold;
    max-width: 80px;
    margin-bottom: 15px;
}
QPushButton#btnGantiFoto:hover { background-color: #EFF6FF; }

/* 2. Tombol Simpan (Biru Besar - Primary) */
QPushButton#btnSimpanProfil {
    background-color: #2563EB;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 12px;
    font-weight: 800;
    font-size: 13px;
    margin-top: 20px;
    border-bottom: 3px solid #1E40AF; /* Efek Tombol Timbul */
}
QPushButton#btnSimpanProfil:hover { 
    background-color: #1D4ED8;
    margin-top: 22px; /* Efek terpencet */
    border-bottom: 1px solid #1E40AF;
}

/* 3. Tombol Ganti Password &amp; Backup (Style List) */
QPushButton#btnGantiPass, QPushButton#btnBackupData {
    background-color: #FFFFFF;
    color: #334155;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 12px;
    font-weight: 600;
    text-align: left;    /* Teks Rata Kiri */
    padding-left: 15px;
    margin-bottom: 10px;
}
QPushButton#btnGantiPass:hover, QPushButton#btnBackupData:hover {
    border-color: #3B82F6;
    color: #2563EB;
    background-color: #F8FAFC;
}

/* 4. Tombol Reset (Bahaya - Merah) */
QPushButton#btnResetApp {
    background-color: #FEF2F2; /* Merah Muda Pucat */
    color: #EF4444;            /* Teks Merah */
    border: 1px dashed #EF4444;
    border-radius: 8px;
    padding: 12px;
    font-weight: 700;
    margin-top: 10px;
}
QPushButton#btnResetApp:hover {
    background-color: #DC2626;
    color: white;
    border: none;
}</string>
