           <widget class="QWidget" name="pageMengajar">
            <property name="styleSheet">
             <string notr="true">/* ============================================================
   HALAMAN MENGAJAR (FULL STYLE - V2.0)
   Clean, Professional, &amp; Integrated Input Form
   ============================================================ */

/* 1. BACKGROUND HALAMAN UTAMA */
QWidget#pageMengajar {
    background-color: #F8FAFC; /* Abu Sangat Muda (Lebih cerah dari F1F5F9) */
}

/* 2. HEADER: JUDUL HALAMAN */
QLabel#lblJudulMengajar {
    font-family: 'Segoe UI', sans-serif;
    font-size: 26px;
    font-weight: 800;       
    color: #1E293B;         
    margin-bottom: 10px;
    letter-spacing: -0.5px;
}

/* 3. AREA FILTER (KOTAK ATAS: KELAS &amp; PERTEMUAN) */
QFrame#frameFilterMengajar {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0; /* Border lebih halus */
    border-radius: 10px;
    padding: 12px;
}

/* Label Kecil di Filter */
QFrame#frameFilterMengajar QLabel {
    font-weight: 700;
    color: #64748B;
    font-size: 12px;
    text-transform: uppercase;
    margin-right: 8px;
}

/* Dropdown (ComboBox) */
QComboBox {
    background-color: #F1F5F9; 
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 8px 15px;
    font-weight: 600;
    color: #334155;
    min-width: 140px;
}
QComboBox:focus {
    border: 1px solid #2563EB;
    background-color: #FFFFFF;
}
QComboBox::drop-down {
    border: none;
    background: transparent;
    width: 20px;
}

/* TOMBOL 'MULAI ABSENSI' */
QPushButton#btnMulaiSesi {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    font-weight: 800;
    font-size: 13px;
    padding: 10px 25px;
    border-bottom: 3px solid #1E40AF;
}
QPushButton#btnMulaiSesi:hover {
    background-color: #1D4ED8;
    margin-top: 2px;
    border-bottom: 1px solid #1E40AF;
}
QPushButton#btnMulaiSesi:pressed {
    background-color: #1E3A8A;
    border-bottom: none;
    margin-top: 4px;
}

/* ------------------------------------------------------------
   4. [BARU] AREA INPUT JURNAL (MATERI &amp; CATATAN)
   ------------------------------------------------------------ */
QFrame#frameFormInput {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-left: 5px solid #2563EB; /* Aksen Biru di Kiri */
    border-radius: 8px;
    padding: 15px 20px;
    margin-top: 15px;
    margin-bottom: 5px;
}

/* Label Judul Input (Materi Pokok / Catatan) */
QFrame#frameFormInput QLabel {
    font-size: 11px;
    font-weight: 800;
    color: #94A3B8;         /* Abu Soft */
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
}

/* Kotak Input Teks */
QLineEdit#inputMateri, QLineEdit#inputCatatanJurnal {
    background-color: #F8FAFC;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 10px 12px;     /* Padding Lega */
    font-size: 14px;
    font-weight: 600;
    color: #1E293B;
}

/* Efek saat diklik (Fokus) */
QLineEdit:focus {
    background-color: #FFFFFF;
    border: 2px solid #2563EB; /* Outline Biru */
    color: #0F172A;
}

/* 5. KARTU PEMBUNGKUS TABEL */
QFrame#cardMengajar {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    border-bottom: 4px solid #CBD5E1;
    margin-top: 15px;
    padding: 5px; /* Padding agar tabel tidak nempel pinggir */
}

/* Sub-Judul 'Daftar Hadir Siswa' */
QLabel#lblSubJudulAbsen {
    font-size: 16px;
    font-weight: 800;
    color: #334155;
    margin: 10px 5px;
}

/* 6. TABEL ABSENSI */
QTableWidget#tableAbsensi {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    gridline-color: #F1F5F9;
    font-size: 13px;
    color: #334155;
    selection-background-color: #EFF6FF;
    selection-color: #1E293B;
    outline: none;
}

/* Header Tabel */
QHeaderView::section {
    background-color: #F8FAFC;
    color: #475569;
    padding: 12px 5px;
    border: none;
    border-bottom: 2px solid #E2E8F0;
    border-right: 1px solid #F1F5F9;
    font-weight: 800;
    font-size: 11px;
    text-transform: uppercase;
}

/* Baris Tabel */
QTableWidget::item {
    padding: 5px;
    border-bottom: 1px solid #F8FAFC;
}

/* 7. SPINBOX (INPUT NILAI 0-100) - Agar cantik di dalam tabel */
QSpinBox {
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    padding: 4px;
    background-color: #F8FAFC;
    font-weight: bold;
}
QSpinBox:focus {
    border: 2px solid #2563EB;
    background-color: #FFFFFF;
}

/* 8. FOOTER &amp; TOMBOL SIMPAN */
QLabel#lblTotalHadir {
    font-size: 14px;
    font-weight: 700;
    color: #334155;
    margin-right: 15px;
}

QPushButton#btnSimpanAbsensi {
    background-color: #10B981; /* Hijau Emerald */
    color: white;
    font-weight: 800;
    border-radius: 8px;
    padding: 12px 30px;
    font-size: 14px;
    border-bottom: 3px solid #059669;
}
QPushButton#btnSimpanAbsensi:hover {
    background-color: #059669;
    margin-top: 2px;
    border-bottom: 1px solid #047857;
}
QPushButton#btnSimpanAbsensi:pressed {
    background-color: #047857;
    border-bottom: none;
    margin-top: 4px;
}

/* 9. SCROLLBAR (Minimalis) */
QScrollBar:vertical {
    border: none;
    background: #F1F5F9;
    width: 8px;
    margin: 0px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: #CBD5E1;
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}</string>
