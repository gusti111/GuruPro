                                <property name="styleSheet">
                                 <string notr="true">/* CSS LANGSUNG DI TOMBOL */
QPushButton {
    background-color: #FFFFFF;
    color: #2563EB;
    border: 2px solid #2563EB;
    border-radius: 14px;
    font-weight: 900;
    font-size: 11px;
    min-width: 60px;
    padding: 4px;
}

QPushButton:hover {
    background-color: #2563EB;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #1E40AF;
    color: #FFFFFF;
}</string>
